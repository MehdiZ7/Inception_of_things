Vagrant.configure("2") do |config|

	config.vm.box = "bento/ubuntu-24.04"

	config.vm.define "mzouhirS" do |first|
		first.vm.hostname = "mzouhirS"
		first.vm.network "private_network", ip: "192.168.56.110"
		first.vm.provider "virtualbox" do |vb|
			vb.memory = 1024
			vb.cpus = 1
			vb.name = "mzouhirS"
		end
		first.vm.provision "shell", path: "scripts/server.sh"
	end

	config.vm.define "mzouhirSW" do |second|
		second.vm.hostname = "mzouhirSW"
		second.vm.network "private_network", ip: "192.168.56.111"
		second.vm.provider "virtualbox" do |vb|
			vb.memory = 1024
			vb.cpus = 1
			vb.name = "mzouhirSW"
		end
		second.vm.provision "shell", path: "scripts/worker.sh"
	end

end
